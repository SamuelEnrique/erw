{
  "permissions": {
    "allow": [
      "Bash(python warehouse/supabase/load.py:*)",
      "Bash(python warehouse/news/ingest.py:*)",
      "Bash(python warehouse/news/score.py:*)",
      "Bash(python warehouse/deals/extract.py:*)",
      "Bash(python warehouse/datacenters/extract.py:*)",
      "Bash(npm run build)",
      "Bash(npm start)",
      "Bash(npm run check)",
      "Bash(git push origin main)",
      "PowerShell(python warehouse/supabase/load.py:*)",
      "PowerShell(python warehouse/news/ingest.py:*)",
      "PowerShell(python warehouse/news/score.py:*)",
      "PowerShell(python warehouse/deals/extract.py:*)",
      "PowerShell(python warehouse/datacenters/extract.py:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm start)",
      "PowerShell(npm run check)",
      "PowerShell(git push origin main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ echo \"Available skills:\"; find -L \"$CLAUDE_PROJECT_DIR/.claude/skills\" -name SKILL.md 2>/dev/null | sort | while IFS= read -r f; do name=$(sed -n 's/^name: *//p' \"$f\" | head -1); desc=$(sed -n 's/^description: *//p' \"$f\" | head -1); printf -- '- %s: %s\\n' \"$name\" \"$desc\"; done; } | python -c \"import json, sys; print(json.dumps({'systemMessage': sys.stdin.read()}))\""
          }
        ]
      }
    ]
  }
}
