.venv/
__pycache__/
*.pyc
runs/
warehouse/raw/
*.egg-info/
.pytest_cache/
.env
# Session 9 ruling: warehouse data leaves git (a hosted Postgres becomes the live store).
# Tables are regenerated by the connectors; see warehouse/output/README.md. Allowlist: the
# public news index, and files under 1 MB that a doc links to (the digests link news_stories).
warehouse/output/*.csv
!warehouse/output/news_index.csv
!warehouse/output/news_stories.csv
# Session 15: the deal tracker's tables, so the CI runner has the deals already extracted
!warehouse/output/energy_deals.csv
!warehouse/output/energy_deals_evidence.csv
# Session 16: the datacenter power tracker's tables, for the same reason
!warehouse/output/datacenter_projects.csv
!warehouse/output/datacenter_projects_evidence.csv
# Session 22: the operator site lists (refreshed weekly) and the matched queue rows (refreshed with the
# queues), so the daily run can rebuild datacenter_facilities every day without them on the runner
!warehouse/output/datacenter_operator_sites.csv
!warehouse/output/datacenter_queue_positions.csv
!warehouse/output/datacenter_facilities.csv
# Session 27: the company database holds the Thesis Builder's researched rows, which no daily step can rebuild
!warehouse/output/energy_companies.csv
# Session 9: run logs belong with the tables they describe; they stay out of git from now on
# (logs committed before session 9 stay tracked).
warehouse/output/logs/
# Session 23: Automated Analysis results of internal templates (never published)
warehouse/output/analysis_internal/
# Session 25: the Thesis Builder's saved states and chart images (rebuildable; not published)
warehouse/output/thesis_state/
warehouse/output/thesis_charts/
